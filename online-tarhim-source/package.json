{
  "name": "online-tarhim-hero",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --emptyOutDir && node scripts/verify-static-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/test_scroll_reveal.cjs scripts/test_static_infrastructure.mjs && python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "check": "npm run typecheck && npm test",
    "healthcheck": "node scripts/check-live.mjs",
    "verify:static": "node scripts/verify-static-build.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
